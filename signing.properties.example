# Engine 与 Vault 共享签名配置模板
#
# 使用方法:
#   1. cp signing.properties.example signing.properties   (两个仓库各放一份)
#   2. 生成一份共享密钥库 (一次性, 两仓库共用同一个文件):
#        keytool -genkeypair -v -keystore ipc-shared.jks -alias ipc-shared \
#          -keyalg RSA -keysize 2048 -validity 9125 \
#          -storepass <你的密码> -keypass <你的密码> \
#          -dname "CN=Engine-Vault IPC Shared"
#   3. 将 ipc-shared.jks 与两份 signing.properties 分发到所有构建机
#      (同一相对路径), 密钥库文件本身不要提交进仓库
#
# 为什么必须共享签名:
#   两 App 的 IPC 入口由 signature 级权限互锁 —— 签名不一致时
#   跨应用唤起与回调全部 SecurityException, 且无法覆盖安装
#   (更新需卸载重装 → Vault 内绑定私钥全清 → 身份永久丢失)。
#
# 安全说明:
#   signing.properties 与 *.jks 均已被 .gitignore 排除, 密钥绝不入库。
#   正式发布时应改用私有 release 密钥库 (同样两工程共用同一份)。
#
# 未配置本文件时: 构建回退到构建机默认 debug keystore (~/.android/debug.keystore)
# —— 此时 Engine 与 Vault 必须在同一台机器构建才能保证签名一致。

storeFile=ipc-shared.jks
storePassword=changeme
keyAlias=ipc-shared
keyPassword=changeme
